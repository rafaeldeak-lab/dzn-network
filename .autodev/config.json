{
  "mode": "pr_only",
  "scope": "dzn_platform",
  "allowDirectMainPush": false,
  "allowAutoMergeLowRisk": false,
  "allowCodexSafeFixes": true,
  "allowCodexHighRiskFixes": false,
  "allowAutomaticProductionDeploy": false,
  "allowProductionMutations": false,
  "maxFixAttemptsPerRun": 3,
  "maxRuntimeMinutes": 45,
  "maxChangedFilesPerRun": 20,
  "maxTokensHint": "bounded",
  "aiSpendPolicy": {
    "mode": "subscription_only",
    "maxExtraMonthlySpendUsd": 0,
    "chatGptBillingSettingsManagedOutsideRepo": true,
    "forbidOpenAiApiKey": true,
    "forbidPaidCodexGitHubAction": true,
    "forbidUnattendedPaidCodexExecution": true,
    "forbidAutomaticCreditsOrAutoTopUp": true,
    "forbidMeteredAiProvidersByDefault": true,
    "overrideRequires": "high_risk_human_approved_redesign"
  },
  "productionUrl": "https://dzn-network.pages.dev",
  "deployPreviewRequired": true,
  "watchAdmCycles": true,
  "watchMinutesAfterDeploy": 90,
  "automationPolicy": {
    "low": {
      "allowedToInvestigate": true,
      "allowedToImplementInBranch": true,
      "allowedToOpenPR": true,
      "allowedToAutoMerge": false,
      "allowedToDeployProduction": false,
      "requiresHumanReview": false
    },
    "medium": {
      "allowedToInvestigate": true,
      "allowedToImplementInBranch": true,
      "allowedToOpenPR": true,
      "allowedToAutoMerge": false,
      "allowedToDeployProduction": false,
      "requiresHumanReview": true
    },
    "high": {
      "allowedToInvestigate": true,
      "allowedToImplementInBranch": true,
      "allowedToOpenPR": true,
      "allowedToAutoMerge": false,
      "allowedToDeployProduction": false,
      "requiresHumanReview": true
    },
    "blocked": {
      "allowedToInvestigate": true,
      "allowedToImplementInBranch": false,
      "allowedToOpenPR": false,
      "allowedToAutoMerge": false,
      "allowedToDeployProduction": false,
      "requiresHumanReview": true
    }
  },
  "systems": {
    "adm": {
      "specialistSubsystem": true,
      "primaryAutomaticRunner": "cloudflare-worker",
      "githubBackupRunner": "manual-only",
      "preserveCycleWatch": true,
      "preserveProductionSmoke": true,
      "preserveProtectedHealth": true,
      "preserveWorkerHeartbeat": true,
      "preserveNitradoDiagnostics": true,
      "preserveRetryBackoff": true
    }
  },
  "codex": {
    "enabled": true,
    "issueLabelsRequired": ["autodev", "autodev-safe-fix", "low-risk"],
    "issueLabelsBlocked": [
      "blocked",
      "high-risk",
      "medium-risk",
      "needs-human-review",
      "security",
      "billing",
      "stripe",
      "auth",
      "discord-oauth",
      "database-destructive",
      "account-management",
      "subscriptions",
      "server-settings-sensitive",
      "worker-cron-high-risk",
      "token-encryption",
      "production-mutation"
    ],
    "openPullRequestOnly": true,
    "directPushToMain": false,
    "autoMerge": false,
    "paidGitHubActionEnabled": false,
    "requiresOpenAiApiKey": false,
    "unattendedPaidExecutionEnabled": false,
    "meteredAiProvidersEnabled": false,
    "assumesAutomaticCreditsOrAutoTopUp": false
  },
  "riskGates": {
    "blockDestructiveMigrations": true,
    "blockProtectedDataDeletion": true,
    "blockPlayerStatsCreation": true,
    "blockSecretExposure": true,
    "blockAuthWeakening": true,
    "blockSameCategoryMatchmakingRemoval": true,
    "blockCloudflareSecretsInGitHub": true,
    "blockGitHubPrimaryAdmRunner": true,
    "blockPaidCodexGitHubAction": true,
    "blockOpenAiApiKey": true,
    "blockUnattendedPaidAiExecution": true,
    "blockMeteredAiProviders": true,
    "blockAutomaticCreditsOrAutoTopUpAssumptions": true
  },
  "validation": {
    "defaultProfile": "general",
    "profiles": [
      "docs",
      "ui",
      "general",
      "auth",
      "billing",
      "nitrado-adm",
      "events",
      "github-workflows",
      "autodev",
      "release-high-risk"
    ]
  }
}
